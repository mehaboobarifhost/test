import org.openqa.selenium.Cookie;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;

import java.net.CookieStore;
import java.net.HttpCookie;
import java.util.Date;
import java.util.concurrent.TimeUnit;

/**
 * This class contains the common function to create a fully logged-in
 * WebDriver instance by performing the hybrid API/UI login.
 */
public class LoginManager {

    // URLs are now part of this login process
    private static final String BASE_URL = "https://novartis-sb1.aprimo.com";
    private static final String APP_HOME_URL = "https://novartis-sb1.aprimo.com/MarketingOps/";

    /**
     * This is the common function you can call from anywhere.
     * It takes credentials, performs the hybrid login, and returns
     * a fully authenticated WebDriver.
     *
     * @param username The username to log in with.
     * @param password The password for the user.
     * @return A logged-in WebDriver instance.
     * @throws Exception if login or setup fails.
     */
    public static WebDriver createLoggedInBrowser(String username, String password) throws Exception {
        System.out.println("LoginManager: Logging in programmatically...");

        // 1. CONFIGURE LOGIN
        // You can also pass a proxy object here if needed
        AprimoLogin loginSession = new AprimoLogin(username, password);

        // 2. GET URL AND COOKIES
        String loginHandoffUrl = loginSession.getLoginCallbackUrl();
        CookieStore cookieStore = loginSession.getCookieStore();

        // 3. Create the driver instance
        WebDriver localDriver = new ChromeDriver();
        localDriver.manage().timeouts().implicitlyWait(10, TimeUnit.SECONDS); // Good practice
        
        // 4. Go to the base domain
        localDriver.get(BASE_URL);

        // 5. Loop, convert, and inject each cookie
        for (HttpCookie httpCookie : cookieStore.getCookies()) {
            Date expiryDate = (httpCookie.getMaxAge() != -1) ? new Date(System.currentTimeMillis() + httpCookie.getMaxAge() * 1000) : null;
            Cookie seleniumCookie = new Cookie(
                    httpCookie.getName(), httpCookie.getValue(), httpCookie.getDomain(),
                    httpCookie.getPath(), expiryDate, httpCookie.getSecure(), httpCookie.isHttpOnly()
            );
            localDriver.manage().addCookie(seleniumCookie);
        }

        // 6. Navigate to App Home URL
        System.out.println("LoginManager: Cookies set. Navigating directly to App Home URL...");
        localDriver.get(APP_HOME_URL);
        
        System.out.println("LoginManager: Browser is now logged in.");
        return localDriver;
    }
}
