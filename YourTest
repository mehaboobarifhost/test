public static void addFileVersionForVersionCompare() throws InterruptedException, IOException {
    //code for add new file version
    if (exec_container.equals("jenkins")) {
        CommonFunctions.setFileDetectorToJenkins();
    }

    String originalFilePath = System.getProperty("user.dir") + "/src/test/java/com/xyz/dam/utils/Images/yyz-Testing_VersionCompare/yyz-Testing_C3 Glomerulopathy 2_VersionCompare_NoChange.docx";
    String uploadedFilePath = /* KEEP YOUR ORIGINAL LINE 5444 HERE, unchanged */;

    try {
        Files.copy(Paths.get(originalFilePath), Paths.get(uploadedFilePath));
        Log.info("File copied to: " + uploadedFilePath);
    } catch (IOException e) {
        Log.error("Failed to create directory: " + e.getMessage());
    }
    Log.info("originalFilePath " + originalFilePath);
    Log.info("uploadedFilePath " + uploadedFilePath);

    WebDriver driver = DriverFactory.getInstance().getDriver();

    driver.findElement(By.xpath("//button[@data-tracking='interaction:upload:upload-new']")).click();
    CommonFunctions.waitInMS(5);

    // NO click on 'select-files': it opens the native file chooser, which Jenkins can't close
    // and which makes Chrome block window.open afterwards. sendKeys on the file input is enough.
    WebElement fileInput = driver.findElement(By.xpath("//input[@type='file']"));
    ((JavascriptExecutor) driver).executeScript(
            "arguments[0].style.display='block'; arguments[0].style.visibility='visible';", fileInput);
    fileInput.sendKeys(uploadedFilePath);

    Log.info("File Uploaded ");
    CommonFunctions.waitInMS(20);
}

