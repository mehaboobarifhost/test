#!/usr/bin/env node
/*
 * Convert Cucumber .feature files into a CSV + config JSON for Xray Cloud's
 * Test Case Importer (Apps > Xray > Test Case Importer > CSV).
 *
 * One CSV row per Scenario / Scenario Outline, Test type = Cucumber.
 * Tags (incl. old @FUS-nnn / @TEST_FUS-nnn) are NOT written to the CSV, so the import
 * always creates NEW tests. tag_mapping.csv records the old tags per scenario.
 *
 * Usage:
 *   node features_to_xray_csv.js --features-dir <folder> --out <out folder> [--project ICP] [--filter TEXT]
 *
 * Output (in --out): xray_import.csv, xray_import_config.json, tag_mapping.csv
 * No npm packages needed (Node 14+).
 */
const fs = require('fs');
const path = require('path');

function arg(name, def) {
  const i = process.argv.indexOf('--' + name);
  return i > -1 && process.argv[i + 1] !== undefined ? process.argv[i + 1] : def;
}
const featuresDir = arg('features-dir');
const outDir = arg('out');
const project = arg('project', 'ICP');
const filter = arg('filter', '');
if (!featuresDir || !outDir) {
  console.error('Usage: node features_to_xray_csv.js --features-dir <folder> --out <folder> [--project ICP] [--filter TEXT]');
  process.exit(1);
}

const STEP_RE = /^(Given|When|Then|And|But|\*)\b/i;
const SCEN_RE = /^(Scenario Outline|Scenario Template|Scenario)\s*:\s*(.*)$/i;
const titleCase = (s) => s.replace(/\w\S*/g, (w) => w[0].toUpperCase() + w.slice(1).toLowerCase());

function walk(dir) {
  let out = [];
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) out = out.concat(walk(p));
    else if (e.name.endsWith('.feature')) out.push(p);
  }
  return out;
}

function parseFeature(file) {
  const lines = fs.readFileSync(file, 'utf8').replace(/^﻿/, '').split(/\r?\n/);
  const scenarios = [];
  let cur = null, pendingTags = [], featureTags = [], inDoc = false, inExamples = false, background = false;
  for (const raw of lines) {
    const line = raw.trim();
    if (inDoc) {
      cur.steps.push(line);
      if (line.startsWith('"""') || line.startsWith('```')) inDoc = false;
      continue;
    }
    if (!line || line.startsWith('#')) continue;
    if (line.startsWith('@')) { pendingTags.push(...line.split(/\s+/)); continue; }
    if (/^Feature\s*:/i.test(line)) { featureTags = pendingTags; pendingTags = []; continue; }
    if (/^Background\s*:/i.test(line)) {
      background = true;
      cur = { name: '(background)', kind: 'bg', tags: [], steps: [], examples: [] };
      pendingTags = []; inExamples = false;
      continue;
    }
    const m = line.match(SCEN_RE);
    if (m) {
      cur = { name: m[2].trim(), kind: titleCase(m[1]), tags: featureTags.concat(pendingTags), steps: [], examples: [] };
      scenarios.push(cur);
      pendingTags = []; inExamples = false;
      continue;
    }
    if (/^(Examples|Scenarios)\s*:/i.test(line) && cur) {
      inExamples = true; cur.examples.push('Examples:'); cur.tags = cur.tags.concat(pendingTags); pendingTags = [];
      continue;
    }
    if (!cur) continue;
    if (inExamples && line.startsWith('|')) cur.examples.push(line);
    else if (line.startsWith('|')) cur.steps.push(line);
    else if (STEP_RE.test(line)) { cur.steps.push(line); if (line.startsWith('"""') || line.endsWith('"""')) inDoc = true; }
    else if (line.startsWith('"""') || line.startsWith('```')) { cur.steps.push(line); inDoc = true; }
    else cur.steps.push(line);
  }
  return { scenarios: scenarios.filter((s) => s.kind !== 'bg'), background };
}

// Tags -> Jira labels. Old issue-key tags are dropped; spaces are not allowed in labels.
const KEY_TAG = /^@?(TEST_|REQ_)?[A-Z][A-Z0-9]+-\d+$/i;
const toLabels = (tags) => [...new Set(tags.filter((t) => !KEY_TAG.test(t))
  .map((t) => t.replace(/^@/, '').replace(/\s+/g, '_')).filter(Boolean))];

const definition = (sc) => sc.steps.join('\n') + (sc.examples.length ? '\n\n' + sc.examples.join('\n') : '');

// CSV helpers: quote a cell when it has the delimiter, a quote or a line break
const cell = (v, delim) => {
  const s = String(v);
  return /["\r\n]/.test(s) || s.includes(delim) ? '"' + s.replace(/"/g, '""') + '"' : s;
};
const row = (arr, delim) => arr.map((c) => cell(c, delim)).join(delim);

const files = walk(featuresDir).filter((f) => !filter || f.includes(filter)).sort();
if (!files.length) { console.error('No .feature files found'); process.exit(1); }

fs.mkdirSync(outDir, { recursive: true });
const rows = [], mapping = [], warnings = [];
let n = 0;
for (const f of files) {
  const { scenarios, background } = parseFeature(f);
  const rel = path.relative(featuresDir, f).split(path.sep).join('/');
  if (background) warnings.push(`${rel}: has a Background - its steps are NOT included in the tests`);
  for (const sc of scenarios) {
    n++;
    if (!sc.steps.length) warnings.push(`${rel}: scenario "${sc.name}" has no steps`);
    rows.push([n, '', 'Cucumber', sc.name, definition(sc), toLabels(sc.tags).join(';')]);
    mapping.push([rel, sc.name, sc.kind, sc.tags.join(' ')]);
  }
}

const BOM = '﻿';
const header = ['Issue Id', 'Issue key', 'Test type', 'Test Summary', 'Gherkin definition', 'Labels'];
fs.writeFileSync(path.join(outDir, 'xray_import.csv'),
  BOM + [row(header, ';'), ...rows.map((r) => row(r, ';'))].join('\r\n') + '\r\n', 'utf8');
fs.writeFileSync(path.join(outDir, 'tag_mapping.csv'),
  BOM + [row(['feature file', 'scenario', 'type', 'original tags'], ','), ...mapping.map((r) => row(r, ','))].join('\r\n') + '\r\n', 'utf8');

const fields = [['Xray', '__xray_testId'], ['Native', '__issue_key'], ['Xray', 'xray_testtype'],
  ['Native', 'summary'], ['Xray', 'xray_gherkin_def'], ['Native', 'labels']];
const cfg = {
  'config.encoding': 'UTF-8', 'config.delimiter': ';', 'config.project.from.csv': false,
  'config.project.key': project, 'config.list.delimiter': ';',
  'config.date.format': 'DD/MM/YYYY HH:mm', 'config.create.test.repository.folders': false,
  'config.field.mappings': fields.map(([group, id], i) => ({ 'column.index': i, 'jira.field': { group, id, type: id === 'labels' ? 'array' : 'string' } })),
};
fs.writeFileSync(path.join(outDir, 'xray_import_config.json'), JSON.stringify(cfg, null, 4), 'utf8');

console.log(`${files.length} feature file(s), ${n} scenario(s) -> ${outDir}`);
warnings.forEach((w) => console.log('WARNING: ' + w));
